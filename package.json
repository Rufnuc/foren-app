{
  "name": "foren-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Foren — survivor evidence vault (disguised entry, AI analysis, Solana commitment)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "cap:sync": "npm run build && cap sync",
    "ios": "npm run build && cap sync ios && cap open ios",
    "android": "npm run build && cap sync android && cap open android"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^7.2.0",
    "@aparajita/capacitor-secure-storage": "^7.1.6",
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@scure/bip39": "^1.6.0",
    "@tanstack/react-query": "^5.59.0",
    "@xenova/transformers": "^2.17.2",
    "circomlibjs": "^0.1.7",
    "dexie": "^4.4.3",
    "dexie-react-hooks": "^1.1.7",
    "hash-wasm": "^4.12.0",
    "jspdf": "^2.5.2",
    "onnxruntime-web": "^1.27.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.27.0",
    "remark-gfm": "^4.0.1",
    "snarkjs": "^0.7.6",
    "tesseract.js": "^5.1.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/node": "^22.19.21",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.12",
    "postcss": "^8.4.47",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^1.3.0"
  }
}
